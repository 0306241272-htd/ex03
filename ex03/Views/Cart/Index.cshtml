@model List<ex03.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
}

<h2 class="mb-4">Giỏ hàng của bạn</h2>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light text-center">
                <tr>
                    <th>Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Đơn giá</th>
                    <th style="width: 150px;">Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 70px; height: 70px; object-fit: cover;" class="rounded" />
                            }
                        </td>
                        <td>
                            <a href="/Home/Details/@item.ProductId" class="text-decoration-none text-dark fw-bold">@item.ProductName</a>
                        </td>
                        <td class="text-end">@item.Price.ToString("N0") VNĐ</td>
                        <td>
                            <form action="/Cart/UpdateQuantity" method="post" class="d-flex align-items-center">
                                <input type="hidden" name="id" value="@item.ProductId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm text-center me-1" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Cập nhật</button>
                            </form>
                        </td>
                        <td class="text-end fw-bold text-danger">@item.TotalPrice.ToString("N0") VNĐ</td>
                        <td class="text-center">
                            <a href="/Cart/RemoveFromCart/@item.ProductId" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa?')">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end fw-bold">Tổng cộng:</td>
                    <td class="text-end fw-bold text-danger fs-5">
                        @Model.Sum(x => x.TotalPrice).ToString("N0") VNĐ
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex justify-content-between mt-3">
        <a href="/" class="btn btn-outline-primary"><i class="fa fa-arrow-left"></i> Tiếp tục mua hàng</a>
        <a href="/Cart/Checkout" class="btn btn-success btn-lg">Tiến hành Thanh toán <i class="fa fa-arrow-right"></i></a>
    </div>
}
else
{
    <div class="text-center py-5">
        <h4>Giỏ hàng của bạn đang trống!</h4>
        <p class="text-muted">Hãy lựa chọn các sản phẩm yêu thích và thêm vào giỏ nhé.</p>
        <a href="/" class="btn btn-primary mt-3">Khám phá sản phẩm</a>
    </div>
}