@model IEnumerable<ex03.Models.Category>

@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="row" style="margin-bottom: 15px;">
    <div class="col-lg-12">
        <a href="/Admin/Category/Create" class="btn btn-primary">
            <i class="fa fa-plus"></i> Thêm mới danh mục
        </a>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading"><b>Danh sách danh mục sản phẩm</b></div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th style="width: 60px;" class="text-center">STT</th>
                        <th>Tên danh mục</th>
                        <th class="text-center" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int stt = 1;
                    }
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@(stt++)</td>
                                <td><b>@item.Name</b></td>
                                <td class="text-center">
                                    <a href="/Admin/Category/Edit/@item.Id" class="btn btn-xs btn-warning">
                                        <i class="fa fa-edit"></i> Sửa
                                    </a>
                                    <a href="/Admin/Category/Delete/@item.Id" class="btn btn-xs btn-danger">
                                        <i class="fa fa-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">Chưa có danh mục nào. Hãy bấm "Thêm mới danh mục" để khởi tạo.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>