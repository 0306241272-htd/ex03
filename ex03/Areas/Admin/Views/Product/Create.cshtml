@model ex03.Models.Product

@{
    ViewData["Title"] = "Thêm mới sản phẩm";
}

<div class="panel panel-default">
    <div class="panel-heading">
        <b>Thêm mới sản phẩm</b>
    </div>
    <div class="panel-body">
        <form action="/Admin/Product/Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-group" style="margin-bottom: 15px;">
                <label class="control-label">Tên sản phẩm</label>
                <input name="Name" class="form-control" placeholder="Nhập tên sản phẩm (VD: iPhone 15 Pro Max)" required />
            </div>

            <div class="form-group" style="margin-bottom: 15px;">
                <label class="control-label">Giá bán (VNĐ)</label>
                <input name="Price" type="number" step="1000" class="form-control" placeholder="Nhập giá bán" required />
            </div>

            <div class="form-group" style="margin-bottom: 15px;">
                <label class="control-label">Danh mục sản phẩm</label>
                <select name="CategoryId" class="form-control" required>
                    <option value="">-- Chọn danh mục --</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (List<ex03.Models.Category>)ViewBag.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 15px;">
                <label class="control-label">Hình ảnh sản phẩm</label>
                <input type="file" name="ImageFile" class="form-control" accept="image/*" />
            </div>

            <div class="form-group" style="margin-bottom: 15px;">
                <label class="control-label">Mô tả sản phẩm</label>
                <textarea name="Description" class="form-control" rows="4" placeholder="Nhập mô tả sản phẩm..."></textarea>
            </div>

            <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Lưu lại</button>
            <a href="/Admin/Product" class="btn btn-default"><i class="fa fa-arrow-left"></i> Quay lại</a>
        </form>
    </div>
</div>