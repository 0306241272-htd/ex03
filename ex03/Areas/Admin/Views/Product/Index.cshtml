@using ex03.Helpers
@model PaginatedList<ex03.Models.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="row" style="margin-bottom: 15px;">
    <div class="col-lg-12">
        <a href="/Admin/Product/Create" class="btn btn-primary">
            <i class="fa fa-plus"></i> Thêm mới sản phẩm
        </a>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading"><b>Danh sách sản phẩm</b></div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th style="width: 50px;" class="text-center">STT</th>
                        <th style="width: 80px;" class="text-center">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá bán</th>
                        <th>Danh mục</th>
                        <th class="text-center" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        // Tính STT liên tục giữa các trang (Trang 1: 1-5, Trang 2: 6-10...)
                        int pageSize = 5;
                        int stt = (Model.PageIndex - 1) * pageSize + 1;
                    }
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@(stt++)</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" style="max-width: 50px; max-height: 50px; object-fit: cover;" class="img-thumbnail" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa có ảnh</span>
                                    }
                                </td>
                                <td><b>@item.Name</b></td>
                                <td>@item.Price.ToString("N0") VNĐ</td>
                                <td>@(item.Category != null ? item.Category.Name : "Chưa phân loại")</td>
                                <td class="text-center">
                                    <a href="/Admin/Product/Edit/@item.Id" class="btn btn-xs btn-warning">
                                        <i class="fa fa-edit"></i> Sửa
                                    </a>
                                    <a href="/Admin/Product/Delete/@item.Id" class="btn btn-xs btn-danger">
                                        <i class="fa fa-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Chưa có sản phẩm nào. Hãy bấm "Thêm mới sản phẩm" để khởi tạo.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Thanh phân trang Admin -->
        @if (Model != null && Model.TotalPages > 1)
        {
            <div class="text-center">
                <ul class="pagination" style="margin: 10px 0 0 0;">
                    <!-- Nút Trang trước -->
                    <li class="@(!Model.HasPreviousPage ? "disabled" : "")">
                        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)">&laquo; Trước</a>
                    </li>

                    <!-- Các nút Số trang -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="@(i == Model.PageIndex ? "active" : "")">
                            <a asp-action="Index" asp-route-pageNumber="@i">@i</a>
                        </li>
                    }

                    <!-- Nút Trang sau -->
                    <li class="@(!Model.HasNextPage ? "disabled" : "")">
                        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)">Sau &raquo;</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>