<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Hệ thống Quản trị</title>

    <!-- Thư viện CSS dùng chung -->
    <link href="~/admin/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/admin/css/metisMenu.min.css" rel="stylesheet">
    <link href="~/admin/css/startmin.css" rel="stylesheet">
    <link href="~/admin/css/font-awesome.min.css" rel="stylesheet" type="text/css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div id="wrapper">
        <!-- Navigation ghép từ 2 Partial Views (ĐÃ SỬA ĐƯỜNG DẪN TẠI ĐÂY) -->
        <nav class="navbar navbar-inverse navbar-fixed-top" role="navigation">
            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_HeaderPartial.cshtml")
            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_SidebarPartial.cshtml")
        </nav>


        <div id="page-wrapper">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">@ViewData["Title"]</h1>
                    </div>
                </div>

                @RenderBody()
            </div>
        </div>
    </div>
    
    <script src="~/admin/js/jquery.min.js"></script>
    <script src="~/admin/js/bootstrap.min.js"></script>
    <script src="~/admin/js/metisMenu.min.js"></script>
    <script src="~/admin/js/startmin.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>